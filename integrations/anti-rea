#!/usr/bin/env bash
# REA-Shield 集成调用包装：解析 Python 解释器并转发到 anti_rea.py。
# 解释器优先级：ANTI_REA_PYTHON > /opt/anti-rea-toolchain 下的 python > PATH 中的 python3。
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

py="${ANTI_REA_PYTHON:-}"
if [ -z "$py" ]; then
  for c in \
    /opt/anti-rea-toolchain/python3.11/bin/python3.11 \
    python3 python; do
    if command -v "$c" >/dev/null 2>&1; then py="$c"; break; fi
  done
fi
if [ -z "$py" ]; then
  echo "anti-rea: 未找到 Python 解释器（设置 ANTI_REA_PYTHON）" >&2
  exit 1
fi
exec "$py" "$here/anti_rea.py" "$@"
